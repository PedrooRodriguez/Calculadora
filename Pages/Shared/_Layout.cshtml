<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Calculadora</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body>
    <div class="container mt-4">
        <nav class="mb-4">
            <a asp-page="/Index" class="btn btn-primary">Inicio</a>
            <a asp-page="/Sumar" class="btn btn-outline-primary">Sumar</a>
            <a asp-page="/Restar" class="btn btn-outline-primary">Restar</a>
            <a asp-page="/Multiplicar" class="btn btn-outline-primary">Multiplicar</a>
            <a asp-page="/Dividir" class="btn btn-outline-primary">Dividir</a>
        </nav>

        <main>
            @RenderBody() <!-- Este es el contenido específico de cada página -->
        </main>

        <footer class="mt-5 text-muted">
            <hr />
            <p>&copy; 2025 - Calculadora Razor</p>
        </footer>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
