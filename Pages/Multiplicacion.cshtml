@page
@model CalculadoraApp.Pages.MultiplicacionModel
@{
    ViewData["Title"] = "Multiplicación";
}

<h2>Multiplicación</h2>

<form method="post">
    <div>
        <label for="num1">Número 1:</label>
        <input type="number" id="num1" name="num1" value="@Model.Num1" required />
    </div>
    <div>
        <label for="num2">Número 2:</label>
        <input type="number" id="num2" name="num2" value="@Model.Num2" required />
    </div>
    <div>
        <button type="submit">Multiplicar</button>
    </div>
</form>

@if (Model.Result != null)
{
    <h3>Resultado: @Model.Result</h3>
}

<a href="/">Volver al inicio</a>
