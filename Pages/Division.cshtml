@page
@model CalculadoraApp.Pages.DivisionModel
@{
    ViewData["Title"] = "División";
}

<h1>División</h1>

<form method="post">
    <div>
        <label for="Numero1">Número 1:</label>
        <input type="number" id="Numero1" name="Numero1" value="@Model.Numero1" />
    </div>
    <div>
        <label for="Numero2">Número 2:</label>
        <input type="number" id="Numero2" name="Numero2" value="@Model.Numero2" />
    </div>
    <button type="submit" class="btn btn-primary">Dividir</button>
</form>

@if (Model.Resultado.HasValue)
{
    <h3>Resultado: @Model.Resultado</h3>
}
@if (Model.Error != null)
{
    <h3 class="text-danger"> @Model.Error</h3>
}

<script>
    // Después de hacer clic en el botón de operación, borrar los campos de entrada
    document.getElementById("btnSumar").onclick = function () {
        // Borrar los campos de entrada después de hacer clic en el botón
        document.getElementById("Numero1").value = '';
        document.getElementById("Numero2").value = '';
    };
</script>